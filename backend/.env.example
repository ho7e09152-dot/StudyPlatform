GITLAB_BASE_URL=https://lab.ssafy.com
GITLAB_ACCESS_TOKEN=replace-with-a-server-side-token
GITLAB_PROJECT_ID=group-name/project-name
GITLAB_DEFAULT_REF=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SERVER_PORT=8080

# 팀원 1 구현 단계에서 사용
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/gitlab
TOKEN_ENCRYPTION_KEY=

# compose.yml의 로컬 기본값과 동일
DB_URL=jdbc:postgresql://localhost:5432/study_workspace
DB_USERNAME=study
DB_PASSWORD=study-local-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=study-local-redis-password
