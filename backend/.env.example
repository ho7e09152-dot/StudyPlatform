GITLAB_BASE_URL=https://lab.ssafy.com
# dev/local 프로필의 PAT 연결 스파이크에서만 선택적으로 사용
GITLAB_ACCESS_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_DEFAULT_REF=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
WORKSPACE_STATE_FILE=.data/workspaces-production.json
DEMO_SEED_ENABLED=false
SERVER_PORT=8080
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=240
RATE_LIMIT_WRITE_PER_MINUTE=60

# 실제 사용자 OAuth 로그인과 프로젝트 연결
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/gitlab/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/provider-accounts/github/callback
OAUTH_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# 설정하지 않으면 로컬 H2 파일 DB를 사용합니다. prod에서는 아래 PostgreSQL 값을 설정합니다.
# DATABASE_URL=jdbc:postgresql://localhost:5432/study_workspace
# DATABASE_USERNAME=study
# DATABASE_PASSWORD=replace-with-a-strong-password
