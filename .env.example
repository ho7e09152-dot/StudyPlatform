# Docker Compose local infrastructure
POSTGRES_DB=study_workspace
POSTGRES_USER=study
POSTGRES_PASSWORD=study-local-password
POSTGRES_PORT=5432

REDIS_PASSWORD=study-local-redis-password
REDIS_PORT=6379

# compose.github-app.yml을 사용하는 경우에만 설정하는 host PEM 절대 경로
# GITHUB_PRIVATE_KEY_HOST_PATH=/absolute/host/path/github-app-private-key.pem
